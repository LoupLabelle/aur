pkgname=ufwrules
pkgver=0.0.2
pkgrel=1
pkgdesc='misc application firewall rules for ufw'
arch=('any')
license=('none')
depends=('ufw')
optdepends=('steam: application rule')
source=('ufwrules-gameservers' 'ufwrules-steam')

package() {
  # cd $srcdir/$pkgname-$pkgver
  install -Dm644 ufwrules-* -t "$pkgdir/etc/ufw/applications.d"
}
md5sums=('a27c5a0f246774914aa15c11a3594241'
         '724ad02efdf78abb32ab40d931928de1')
